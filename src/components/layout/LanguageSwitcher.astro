---
import {
  localeUrl,
  locales,
  useTranslations,
  type Locale,
} from "../../i18n/utils";

interface Props {
  lang: Locale;
  class?: string;
}

const { lang, class: className } = Astro.props;
const t = useTranslations(lang);
---

<div
  role="group"
  aria-label={t.a11y.language}
  class:list={[
    "flex items-center rounded-full border border-border bg-surface/60 p-0.5 font-mono text-xs",
    className,
  ]}
>
  {
    locales.map((l) => (
      <a
        href={localeUrl(l)}
        hreflang={l}
        lang={l}
        aria-current={l === lang ? "true" : undefined}
        class:list={[
          "rounded-full px-2.5 py-1 uppercase transition-colors",
          l === lang ? "bg-accent-strong text-fg" : "text-muted hover:text-fg",
        ]}
      >
        {l}
      </a>
    ))
  }
</div>
