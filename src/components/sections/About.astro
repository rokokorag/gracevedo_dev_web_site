---
import ImageSlot from "../ui/ImageSlot.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import { site } from "../../data/site";
import { useTranslations, type Locale } from "../../i18n/utils";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
  id="about"
  aria-labelledby="about-title"
  class="mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32"
>
  <div
    class="grid items-start gap-12 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] md:gap-16"
  >
    <div class="reveal relative mx-auto w-full max-w-sm md:max-w-none">
      <div
        aria-hidden="true"
        class="absolute -inset-3 -z-10 rounded-3xl bg-linear-to-br from-accent-strong/30 to-transparent blur-2xl"
      >
      </div>
      <ImageSlot
        variant="portrait"
        image={site.portrait}
        alt={t.about.portraitAlt}
        sizes="(min-width: 768px) 40vw, 384px"
        class="aspect-4/5 rounded-2xl border border-border"
      />
    </div>

    <div>
      <SectionHeading
        id="about-title"
        eyebrow={t.about.eyebrow}
        title={t.about.title}
      />
      <div class="reveal space-y-5 text-lg text-pretty text-muted">
        {t.about.paragraphs.map((p) => <p>{p}</p>)}
      </div>
      <dl
        class="reveal mt-10 grid gap-6 border-t border-border pt-8 sm:grid-cols-2"
      >
        <div>
          <dt
            class="font-mono text-xs tracking-widest text-accent-soft uppercase"
          >
            {t.about.interestsLabel}
          </dt>
          <dd class="mt-2 text-fg">{t.about.interests}</dd>
        </div>
        <div>
          <dt
            class="font-mono text-xs tracking-widest text-accent-soft uppercase"
          >
            {t.about.languagesLabel}
          </dt>
          <dd class="mt-2 text-fg">{t.about.languages}</dd>
        </div>
      </dl>
    </div>
  </div>
</section>
