---
import { Mail } from "@lucide/astro";
import SectionHeading from "../ui/SectionHeading.astro";
import SocialIcon from "../ui/SocialIcon.astro";
import { activeSocials, site } from "../../data/site";
import { useTranslations, type Locale } from "../../i18n/utils";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
  id="contact"
  aria-labelledby="contact-title"
  class="mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32"
>
  <div
    class="relative isolate overflow-hidden rounded-3xl border border-border bg-surface px-6 py-14 sm:px-12 sm:py-20"
  >
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
      <div
        class="absolute -bottom-40 left-1/2 h-96 w-[48rem] -translate-x-1/2 rounded-full bg-[radial-gradient(closest-side,--theme(--color-accent-strong/40%),transparent)] blur-2xl"
      >
      </div>
      <div class="absolute inset-0 bg-grain opacity-15 mix-blend-overlay"></div>
    </div>

    <SectionHeading
      id="contact-title"
      eyebrow={t.contact.eyebrow}
      title={t.contact.title}
      intro={t.contact.text}
    />

    <div class="reveal flex flex-col gap-8">
      <a
        href={`mailto:${site.email}`}
        class="group inline-flex w-fit max-w-full items-center gap-3 text-2xl font-semibold tracking-tight break-all sm:text-4xl"
      >
        <span
          class="grid size-12 shrink-0 place-items-center rounded-full bg-accent-strong text-fg transition-colors group-hover:bg-red-600"
        >
          <Mail size={22} />
        </span>
        <span
          class="underline decoration-accent/50 decoration-2 underline-offset-8 transition-colors group-hover:decoration-accent"
        >
          {site.email}
        </span>
        <span class="sr-only">— {t.contact.emailLabel}</span>
      </a>

      {
        activeSocials.length > 0 && (
          <div>
            <p class="mb-3 font-mono text-xs tracking-widest text-muted uppercase">
              {t.contact.elsewhere}
            </p>
            <ul class="flex flex-wrap gap-3">
              {activeSocials.map((social) => (
                <li>
                  <a
                    href={social.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group/social inline-flex items-center gap-2 rounded-full border border-border bg-bg/60 px-4 py-2 text-sm transition-colors hover:border-accent/60"
                  >
                    <SocialIcon
                      path={social.icon}
                      size={16}
                      class="text-muted transition-colors group-hover/social:text-accent"
                    />
                    {social.label}
                    <span class="sr-only">({t.a11y.newTab})</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </div>
</section>
