---
import { ArrowDown, ArrowRight, Download, MapPin } from "@lucide/astro";
import Lanyard from "../ui/Lanyard.astro";
import SocialIcon from "../ui/SocialIcon.astro";
import { activeSocials, site } from "../../data/site";
import { useTranslations, type Locale } from "../../i18n/utils";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Quick links for recruiters next to the main calls to action.
const heroSocials = activeSocials.filter(
  (s) => s.id === "github" || s.id === "linkedin",
);
---

<!-- `--lanyard-*` size the hanging badge (ui/Lanyard) and, below xl, push the copy under it. -->
<section
  id="top"
  class="group/hero relative isolate overflow-hidden pt-16 [--lanyard-badge:22rem] [--lanyard-rope:6.5rem] xl:[--lanyard-badge:27rem] xl:[--lanyard-rope:clamp(10rem,30svh,16rem)]"
>
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <!-- Glow "warms up" like a light bulb while the pointer is over the hero. -->
    <div
      class="absolute -top-40 left-1/2 h-[42rem] w-[60rem] -translate-x-1/2 rounded-full bg-[radial-gradient(closest-side,--theme(--color-accent-strong/65%),transparent)] opacity-55 blur-3xl glow-ease group-hover/hero:scale-125 group-hover/hero:opacity-100"
    >
    </div>
    <div
      class="absolute -top-28 left-1/2 h-[30rem] w-[44rem] -translate-x-1/2 rounded-full bg-[radial-gradient(closest-side,--theme(--color-accent/85%),transparent)] opacity-0 blur-3xl glow-ease group-hover/hero:opacity-100"
    >
    </div>
    <div class="absolute inset-0 bg-grain opacity-[0.12] mix-blend-overlay">
    </div>
  </div>

  <div
    class="mx-auto flex min-h-[min(calc(100svh-4rem),56rem)] max-w-6xl flex-col px-4 pt-[calc(var(--lanyard-rope)+var(--lanyard-badge)-1.5rem)] pb-16 sm:px-6 xl:justify-center xl:py-20"
  >
    <!-- The role and the name are shown on the lanyard badge, which is decorative, so they stay here for assistive tech. -->
    <p class="sr-only">{t.hero.eyebrow}</p>

    <h1
      style="--reveal-delay: 120ms"
      class="reveal max-w-4xl text-5xl leading-[1.05] font-semibold tracking-tighter text-balance sm:text-6xl lg:text-7xl xl:max-w-176"
    >
      <span class="sr-only">{site.name}.</span>
      <span class="block text-gradient-accent">{t.hero.headline}</span>
    </h1>

    <p
      style="--reveal-delay: 260ms"
      class="reveal mt-6 max-w-2xl text-lg text-pretty text-muted sm:text-xl"
    >
      {t.hero.tagline}
    </p>

    <p
      style="--reveal-delay: 360ms"
      class="reveal mt-4 inline-flex items-center gap-1.5 font-mono text-sm text-muted"
    >
      <MapPin size={14} class="text-accent" />
      {t.hero.location}
    </p>

    <div
      style="--reveal-delay: 460ms"
      class="reveal mt-10 flex flex-wrap gap-3"
    >
      <a
        href="#contact"
        class="inline-flex items-center gap-2 rounded-full bg-accent-strong px-6 py-3 font-medium text-fg shadow-[0_0_40px_-8px] shadow-accent/60 transition-colors hover:bg-red-600"
      >
        {t.hero.ctaContact}
        <ArrowRight size={18} />
      </a>
      <a
        href="#projects"
        class="inline-flex items-center gap-2 rounded-full border border-border bg-surface/60 px-6 py-3 font-medium text-fg backdrop-blur transition-colors hover:border-accent/60"
      >
        {t.hero.ctaProjects}
        <ArrowDown size={18} />
      </a>
      {
        site.cvUrl && (
          <a
            href={site.cvUrl}
            download
            class="inline-flex items-center gap-2 rounded-full px-6 py-3 font-medium text-muted transition-colors hover:text-fg"
          >
            <Download size={18} />
            {t.hero.ctaCv}
          </a>
        )
      }
      {
        heroSocials.length > 0 && (
          <ul class="flex items-center gap-2">
            {heroSocials.map((social) => (
              <li>
                <a
                  href={social.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="grid size-12 place-items-center rounded-full border border-border bg-surface/60 text-muted backdrop-blur transition-colors hover:border-accent/60 hover:text-fg"
                >
                  <SocialIcon path={social.icon} size={18} />
                  <span class="sr-only">
                    {social.label} ({t.a11y.newTab})
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>

  <Lanyard lang={lang} />
</section>
