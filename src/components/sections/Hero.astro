---
import { ArrowDown, ArrowRight, Download, MapPin } from "@lucide/astro";
import { site } from "../../data/site";
import { useTranslations, type Locale } from "../../i18n/utils";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="top" class="group/hero relative isolate overflow-hidden pt-16">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <!-- Glow "warms up" like a light bulb while the pointer is over the hero. -->
    <div
      class="absolute -top-40 left-1/2 h-[42rem] w-[60rem] -translate-x-1/2 rounded-full bg-[radial-gradient(closest-side,--theme(--color-accent-strong/65%),transparent)] opacity-55 blur-3xl glow-ease group-hover/hero:scale-125 group-hover/hero:opacity-100"
    >
    </div>
    <div
      class="absolute -top-28 left-1/2 h-[30rem] w-[44rem] -translate-x-1/2 rounded-full bg-[radial-gradient(closest-side,--theme(--color-accent/85%),transparent)] opacity-0 blur-3xl glow-ease group-hover/hero:opacity-100"
    >
    </div>
    <div
      class="absolute inset-0 bg-[linear-gradient(to_right,--theme(--color-border/35%)_1px,transparent_1px),linear-gradient(to_bottom,--theme(--color-border/35%)_1px,transparent_1px)] mask-[radial-gradient(ellipse_60%_55%_at_50%_35%,black,transparent)] bg-size-[4rem_4rem]"
    >
    </div>
    <div class="absolute inset-0 bg-grain opacity-[0.12] mix-blend-overlay">
    </div>
  </div>

  <div
    class="mx-auto flex min-h-[min(calc(100svh-4rem),56rem)] max-w-6xl flex-col justify-center px-4 py-20 sm:px-6"
  >
    <p
      class="reveal mb-6 inline-flex w-fit items-center gap-2 rounded-full border border-border bg-surface/60 px-3 py-1 font-mono text-xs text-muted backdrop-blur"
    >
      <span aria-hidden="true" class="relative flex size-2">
        <span
          class="absolute inline-flex size-full rounded-full bg-accent opacity-75 motion-safe:animate-ping"
        ></span>
        <span class="relative inline-flex size-2 rounded-full bg-accent"></span>
      </span>
      {t.hero.eyebrow}
    </p>

    <h1
      style="--reveal-delay: 120ms"
      class="reveal max-w-4xl text-5xl leading-[1.05] font-semibold tracking-tighter text-balance sm:text-6xl lg:text-7xl"
    >
      <span class="block text-fg">{site.name}.</span>
      <span class="block text-gradient-accent">{t.hero.headline}</span>
    </h1>

    <p
      style="--reveal-delay: 260ms"
      class="reveal mt-6 max-w-2xl text-lg text-pretty text-muted sm:text-xl"
    >
      {t.hero.tagline}
    </p>

    <p
      style="--reveal-delay: 360ms"
      class="reveal mt-4 inline-flex items-center gap-1.5 font-mono text-sm text-muted"
    >
      <MapPin size={14} class="text-accent" />
      {t.hero.location}
    </p>

    <div
      style="--reveal-delay: 460ms"
      class="reveal mt-10 flex flex-wrap gap-3"
    >
      <a
        href="#contact"
        class="inline-flex items-center gap-2 rounded-full bg-accent-strong px-6 py-3 font-medium text-fg shadow-[0_0_40px_-8px] shadow-accent/60 transition-colors hover:bg-red-600"
      >
        {t.hero.ctaContact}
        <ArrowRight size={18} />
      </a>
      <a
        href="#projects"
        class="inline-flex items-center gap-2 rounded-full border border-border bg-surface/60 px-6 py-3 font-medium text-fg backdrop-blur transition-colors hover:border-accent/60"
      >
        {t.hero.ctaProjects}
        <ArrowDown size={18} />
      </a>
      {
        site.cvUrl && (
          <a
            href={site.cvUrl}
            download
            class="inline-flex items-center gap-2 rounded-full px-6 py-3 font-medium text-muted transition-colors hover:text-fg"
          >
            <Download size={18} />
            {t.hero.ctaCv}
          </a>
        )
      }
    </div>
  </div>
</section>
