---
import { ArrowUpRight } from "@lucide/astro";
import ImageSlot from "../ui/ImageSlot.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import { photos } from "../../data/photos";
import { site } from "../../data/site";
import { useTranslations, type Locale } from "../../i18n/utils";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
  id="photography"
  aria-labelledby="photography-title"
  class="relative overflow-hidden border-y border-border bg-surface/30"
>
  <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32">
    <div
      class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between"
    >
      <SectionHeading
        id="photography-title"
        eyebrow={t.photography.eyebrow}
        title={t.photography.title}
        intro={t.photography.text}
      />
      <a
        href={site.photographyUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="reveal mb-10 inline-flex w-fit shrink-0 items-center gap-2 rounded-full border border-border bg-surface px-5 py-2.5 font-medium transition-colors hover:border-accent/60 sm:mb-14"
      >
        {t.photography.cta}
        <span class="sr-only">({t.a11y.newTab})</span>
        <ArrowUpRight size={18} class="text-accent" />
      </a>
    </div>

    <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        photos.map((photo, i) => (
          <li class:list={["reveal", i % 2 === 1 && "lg:translate-y-8"]}>
            <ImageSlot
              variant="photo"
              image={photo.image}
              alt={photo.alt ?? t.photography.photoAlt}
              sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
              class="aspect-4/5 rounded-xl border border-border"
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>
