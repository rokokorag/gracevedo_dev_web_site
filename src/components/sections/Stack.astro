---
import { Bot, Cloud, CodeXml, Globe, Server, Smartphone } from "@lucide/astro";
import SectionHeading from "../ui/SectionHeading.astro";
import { stack, type StackCategoryId } from "../../data/stack";
import { useTranslations, type Locale } from "../../i18n/utils";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const icons: Record<StackCategoryId, typeof CodeXml> = {
  languages: CodeXml,
  mobile: Smartphone,
  web: Globe,
  backend: Server,
  devops: Cloud,
  ai: Bot,
};

// Bento layout: wider tiles for the bigger groups.
const spans: Record<StackCategoryId, string> = {
  languages: "md:col-span-4",
  mobile: "md:col-span-2",
  web: "md:col-span-3",
  backend: "md:col-span-3",
  devops: "md:col-span-6",
  ai: "md:col-span-6",
};
---

<section
  id="stack"
  aria-labelledby="stack-title"
  class="mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32"
>
  <SectionHeading
    id="stack-title"
    eyebrow={t.stack.eyebrow}
    title={t.stack.title}
    intro={t.stack.intro}
  />

  <div class="grid gap-4 md:grid-cols-6">
    {
      stack.map((category, i) => {
        const Icon = icons[category.id];
        return (
          <div
            style={`--reveal-delay: ${i * 90}ms`}
            class:list={[
              "reveal group relative overflow-hidden rounded-2xl border border-border bg-surface p-6 transition-colors duration-300 hover:border-accent/50",
              spans[category.id],
            ]}
          >
            <div
              aria-hidden="true"
              class="pointer-events-none absolute -top-16 -right-16 size-40 rounded-full bg-accent-strong/0 blur-3xl transition-colors duration-500 group-hover:bg-accent-strong/30"
            />
            <div class="relative mb-5 flex items-center gap-3">
              <span class="grid size-10 place-items-center rounded-lg border border-border bg-surface-2 text-accent">
                <Icon size={20} stroke-width={1.75} />
              </span>
              <h3 class="font-semibold">{t.stack.categories[category.id]}</h3>
            </div>
            <ul class="relative flex flex-wrap gap-2">
              {category.items.map((item) => (
                <li class="rounded-md border border-border bg-bg/60 px-2.5 py-1 font-mono text-sm text-fg/90">
                  {item}
                </li>
              ))}
            </ul>
          </div>
        );
      })
    }
  </div>
</section>
