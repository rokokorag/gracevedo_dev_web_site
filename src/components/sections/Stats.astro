---
import { stats } from "../../data/stats";
import { useTranslations, type Locale } from "../../i18n/utils";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
  id="stats"
  aria-label={t.stats.label}
  class="border-y border-border bg-surface/40"
>
  <dl
    class="mx-auto grid max-w-6xl divide-y divide-border px-4 sm:grid-cols-3 sm:divide-x sm:divide-y-0 sm:px-6"
  >
    {
      stats.map((stat) => (
        <div class="reveal flex flex-col gap-2 py-8 sm:px-8 sm:first:pl-0 sm:last:pr-0">
          <dt class="order-2 text-sm text-pretty text-muted">
            {t.stats.items[stat.id]}
          </dt>
          <dd class="order-1 font-mono text-4xl font-semibold tracking-tight text-fg sm:text-5xl">
            <span class="text-gradient-accent">{stat.value}</span>
          </dd>
        </div>
      ))
    }
  </dl>
</section>
