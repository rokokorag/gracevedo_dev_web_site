---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { Camera, Globe, Smartphone } from "@lucide/astro";
import { site } from "../../data/site";
import type { Platform } from "../../data/projects";

interface Props {
  variant: "project" | "photo" | "portrait";
  image?: ImageMetadata;
  alt: string;
  // Project placeholders show the platform icon.
  platform?: Platform;
  // Responsive `sizes` hint for the optimized image.
  sizes?: string;
  class?: string;
}

const {
  variant,
  image,
  alt,
  platform = "web",
  sizes = "100vw",
  class: className,
} = Astro.props;
const PlatformIcon = platform === "web" ? Globe : Smartphone;
---

<div class:list={["relative overflow-hidden", className]}>
  {
    image ? (
      <Image
        src={image}
        alt={alt}
        sizes={sizes}
        widths={[400, 800, 1200, image.width].filter((w) => w <= image.width)}
        class="h-full w-full object-cover"
      />
    ) : variant === "portrait" ? (
      <div
        aria-hidden="true"
        class="grid h-full w-full place-items-center bg-surface bg-[radial-gradient(circle_at_50%_40%,--theme(--color-accent-strong/45%),transparent_65%)]"
      >
        <div class="absolute inset-0 bg-grain opacity-25 mix-blend-overlay" />
        <span class="relative font-mono text-6xl font-semibold tracking-tight text-fg/90 drop-shadow-[0_0_24px_rgb(239_68_68/0.55)] sm:text-7xl">
          {site.monogram}
        </span>
      </div>
    ) : variant === "photo" ? (
      <div
        aria-hidden="true"
        class="grid h-full w-full place-items-center bg-linear-to-br from-surface-2 to-bg"
      >
        <div class="absolute inset-0 bg-grain opacity-30 mix-blend-overlay" />
        <Camera size={28} stroke-width={1.5} class="relative text-muted/50" />
      </div>
    ) : (
      <div
        aria-hidden="true"
        class="grid h-full w-full place-items-center bg-surface-2 bg-[radial-gradient(ellipse_at_top_right,--theme(--color-accent-strong/40%),transparent_60%)]"
      >
        <div class="absolute inset-0 bg-[linear-gradient(to_right,--theme(--color-border/60%)_1px,transparent_1px),linear-gradient(to_bottom,--theme(--color-border/60%)_1px,transparent_1px)] mask-[radial-gradient(ellipse_at_center,black_30%,transparent_75%)] bg-size-[2rem_2rem]" />
        <PlatformIcon
          size={40}
          stroke-width={1.25}
          class="relative text-fg/70"
        />
      </div>
    )
  }
</div>
