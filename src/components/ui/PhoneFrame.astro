---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  screenshot: ImageMetadata;
  alt: string;
  // Featured cards show the whole phone; regular cards let it rise from the bottom edge.
  featured?: boolean;
}

const { screenshot, alt, featured = false } = Astro.props;
---

<div
  class="absolute inset-0 overflow-hidden bg-surface-2 bg-[radial-gradient(ellipse_at_50%_45%,--theme(--color-accent-strong/45%),transparent_65%)]"
>
  <div
    aria-hidden="true"
    class="absolute inset-0 bg-[linear-gradient(to_right,--theme(--color-border/50%)_1px,transparent_1px),linear-gradient(to_bottom,--theme(--color-border/50%)_1px,transparent_1px)] mask-[radial-gradient(ellipse_at_center,black_20%,transparent_70%)] bg-size-[2rem_2rem]"
  >
  </div>

  <div
    class:list={[
      "absolute left-1/2 aspect-[1242/2688] -translate-x-1/2 rounded-[13%/6%] bg-neutral-950 p-[3.2%] shadow-[0_30px_60px_-15px_rgb(0_0_0/0.8),0_0_0_1px_rgb(255_255_255/0.12)] ring-1 ring-black",
      featured
        ? "top-1/2 h-[84%] max-h-[34rem] -translate-y-1/2"
        : "top-[14%] h-[150%]",
    ]}
  >
    <div class="relative h-full w-full overflow-hidden rounded-[11%/5%]">
      <Image
        src={screenshot}
        alt={alt}
        widths={[300, 600]}
        sizes={featured ? "(min-width: 768px) 260px, 220px" : "200px"}
        class="h-full w-full object-cover object-top"
      />
      <span
        aria-hidden="true"
        class="absolute top-[1.6%] left-1/2 h-[3.4%] w-[30%] -translate-x-1/2 rounded-full bg-black"
      ></span>
    </div>
  </div>
</div>
